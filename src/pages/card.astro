---
import Layout from '../layouts/Layout.astro';

// ★ここを編集してください★
const message = "はじめまして！きゃるです🥕";
---

<Layout
  title="きゃる | 歌い手 × MIX"
  description="歌い手きゃるのリンクページ"
  hideNavbar={true}
>
  <div class="card-page">
    <!-- 背景オーブ -->
    <div class="bg-orbs">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <main class="card-main">
      <!-- プロフィール -->
      <div class="profile-section stagger-1">
        <div class="avatar-wrapper">
          <div class="avatar-ring"></div>
          <img
            src="/photos/profile-main.png"
            alt="きゃる"
            class="avatar"
            width="120"
            height="120"
          />
        </div>
        <h1 class="name">きゃる</h1>
        <p class="role">歌い手 × 歌ってみたMIX</p>
      </div>

      <!-- 一言メッセージ -->
      <div class="message-section stagger-2">
        <p class="message">"{message}"</p>
      </div>

      <!-- SNSリンク -->
      <nav class="links-section stagger-3" aria-label="SNSリンク">
        <a href="https://x.com/carrot_tpa" target="_blank" rel="noopener noreferrer" class="link-card">
          <span class="link-icon">𝕏</span>
          <span class="link-name">X (Twitter)</span>
          <svg class="link-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <a href="https://www.youtube.com/@carrot_singer" target="_blank" rel="noopener noreferrer" class="link-card">
          <span class="link-icon link-icon--youtube">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </span>
          <span class="link-name">YouTube</span>
          <svg class="link-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <a href="https://web.colorsing.com/share/live?live_id=2d0a51ab-7078-4853-9864-5078fbb9ebab" target="_blank" rel="noopener noreferrer" class="link-card">
          <span class="link-icon">🎵</span>
          <span class="link-name">ColorSing</span>
          <svg class="link-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <a href="https://discord.gg/qF7c6PfgJw" target="_blank" rel="noopener noreferrer" class="link-card link-card--discord">
          <span class="link-icon link-icon--discord">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </span>
          <div class="link-text">
            <span class="link-name">Discord</span>
            <span class="link-desc">きゃるのサーバー</span>
          </div>
          <svg class="link-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <div class="link-card link-card--disabled">
          <span class="link-icon">🌐</span>
          <span class="link-name">Topia</span>
          <span class="link-soon">近日公開</span>
        </div>
      </nav>

      <p class="footer-note">© きゃる</p>
    </main>
  </div>
</Layout>

<style>
  /* ===== Base ===== */
  .card-page {
    min-height: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 3rem 1.25rem 2rem;
  }

  /* ===== Background Orbs ===== */
  .bg-orbs {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .orb-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 140, 66, 0.35) 0%, transparent 70%);
    top: -80px;
    right: -60px;
    animation: drift1 12s ease-in-out infinite;
  }

  .orb-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.25) 0%, transparent 70%);
    bottom: 10%;
    left: -80px;
    animation: drift2 15s ease-in-out infinite;
  }

  .orb-3 {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(212, 165, 116, 0.2) 0%, transparent 70%);
    top: 50%;
    right: 10%;
    animation: drift3 10s ease-in-out infinite;
  }

  @keyframes drift1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, 30px); }
  }

  @keyframes drift2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(25px, -20px); }
  }

  @keyframes drift3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-15px, 15px); }
  }

  /* ===== Main Content ===== */
  .card-main {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* ===== Stagger Animation ===== */
  .stagger-1 { animation: fadeUp 0.7s ease-out 0.1s both; }
  .stagger-2 { animation: fadeUp 0.7s ease-out 0.3s both; }
  .stagger-3 { animation: fadeUp 0.7s ease-out 0.5s both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== Profile ===== */
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .avatar-wrapper {
    position: relative;
    width: 120px;
    height: 120px;
  }

  .avatar-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: conic-gradient(
      var(--color-accent),
      var(--color-accent2),
      var(--color-cream),
      var(--color-accent)
    );
    animation: spin 4s linear infinite;
    opacity: 0.8;
  }

  .avatar-ring::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-bg);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .avatar {
    position: relative;
    z-index: 1;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .name {
    font-family: var(--font-accent);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-accent) 60%, var(--color-accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    line-height: 1.1;
  }

  .role {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* ===== Message ===== */
  .message-section {
    width: 100%;
  }

  .message {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: var(--color-warm);
    text-align: center;
    line-height: 1.7;
    margin: 0;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 180, 100, 0.05);
    border: 1px solid rgba(255, 140, 66, 0.12);
    border-radius: 16px;
    backdrop-filter: blur(8px);
  }

  /* ===== Links ===== */
  .links-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    min-height: 64px;
    background: rgba(255, 180, 100, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    backdrop-filter: blur(10px);
    box-shadow:
      0 3px 0 rgba(13, 10, 7, 0.4),
      0 6px 15px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    position: relative;
    overflow: hidden;
  }

  .link-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .link-card:active {
    transform: scale(0.97);
    box-shadow:
      0 1px 0 rgba(13, 10, 7, 0.4),
      0 3px 8px rgba(0, 0, 0, 0.2);
  }

  .link-card:active::before {
    opacity: 1;
  }

  @media (hover: hover) {
    .link-card:hover {
      border-color: rgba(255, 140, 66, 0.3);
      transform: translateX(6px);
      box-shadow:
        0 4px 0 rgba(13, 10, 7, 0.3),
        0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .link-card:hover::before {
      opacity: 1;
    }

    .link-card:hover .link-arrow {
      opacity: 1;
      transform: translate(3px, -3px);
    }
  }

  /* Discord */
  .link-card--discord::before {
    background: linear-gradient(135deg, rgba(88, 101, 242, 0.12) 0%, transparent 60%);
  }

  @media (hover: hover) {
    .link-card--discord:hover {
      border-color: rgba(88, 101, 242, 0.35);
    }
  }

  /* Disabled (Topia) */
  .link-card--disabled {
    opacity: 0.4;
    cursor: default;
  }

  .link-icon {
    font-size: 1.3rem;
    width: 2rem;
    text-align: center;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .link-icon--youtube { color: #ff0000; }
  .link-icon--discord { color: #5865F2; }

  .link-name {
    flex: 1;
    font-size: 1rem;
    font-weight: 500;
  }

  .link-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .link-desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .link-arrow {
    opacity: 0.4;
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .link-soon {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: rgba(255, 180, 100, 0.08);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    padding: 0.2rem 0.6rem;
  }

  /* ===== Footer ===== */
  .footer-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.4;
    margin: 0;
    padding-bottom: 0.5rem;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
---

<Layout>
  <div class="home">

    <!-- ===== Hero / Cover ===== -->
    <header class="cover">
      <div class="cover-grid">
        <div class="cover-text">
          <div class="cover-meta">
            <span class="meta-num">№ 001</span>
            <span class="meta-divider"></span>
            <span class="meta-label">Singer · Mix Engineer</span>
          </div>

          <h1 class="cover-title">
            <span class="cover-en">KYARU</span>
            <span class="cover-ja">きゃる</span>
          </h1>

          <p class="cover-tagline">
            歌い手として、ミックスエンジニアとして。<br />
            言葉と声で、その人らしい音を仕立てる。
          </p>

          <a href="https://x.com/carrot_tpa" target="_blank" rel="noopener noreferrer" class="cover-cta">
            <span>Contact</span>
            <span class="cta-line"></span>
          </a>
        </div>

        <figure class="cover-figure">
          <img
            src="/photos/profile-main.png"
            alt="きゃる"
            class="cover-photo"
          />
          <figcaption class="cover-caption">Photograph — きゃる</figcaption>
        </figure>
      </div>
    </header>

    <!-- ===== About ===== -->
    <section class="page-section reveal">
      <header class="section-head">
        <span class="section-num">01</span>
        <h2 class="section-title">About</h2>
      </header>

      <div class="section-body about-body">
        <p class="lead">
          歌い手として活動している、きゃるです。
        </p>
        <p>
          YouTubeでの歌ってみた動画投稿のほか、ColorSing・Topiaなどの配信プラットフォームで活動。
          歌ってみたのセルフミックスも手がけており、ご依頼も少しずついただいています。
        </p>
        <p class="signature">— きゃる</p>
      </div>
    </section>

    <!-- ===== Latest Video ===== -->
    <section class="page-section reveal">
      <header class="section-head">
        <span class="section-num">02</span>
        <h2 class="section-title">Latest Recording</h2>
      </header>

      <div class="section-body">
        <div class="video-frame">
          <iframe
            src="https://www.youtube.com/embed/oUo-AYvWA0Y?si=97sgSv4IrGDtvBri"
            title="きゃる 歌ってみた動画"
            frameborder="0"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <a href="https://www.youtube.com/@carrot_singer" target="_blank" rel="noopener noreferrer" class="text-link">
          チャンネルへ →
        </a>
      </div>
    </section>

    <!-- ===== Activities ===== -->
    <section class="page-section reveal">
      <header class="section-head">
        <span class="section-num">03</span>
        <h2 class="section-title">Activities</h2>
      </header>

      <div class="section-body">
        <ol class="entry-list">
          <li class="entry">
            <span class="entry-num">i.</span>
            <div class="entry-text">
              <h3>歌ってみた</h3>
              <p>様々な楽曲をカバーし、YouTubeやSNSで発信。</p>
            </div>
          </li>
          <li class="entry">
            <span class="entry-num">ii.</span>
            <div class="entry-text">
              <h3>配信活動</h3>
              <p>ColorSing、Topiaなどの配信プラットフォームで歌配信。</p>
            </div>
          </li>
          <li class="entry">
            <span class="entry-num">iii.</span>
            <div class="entry-text">
              <h3>MIX制作</h3>
              <p>歌ってみた動画の音源MIX・マスタリングを承っています。</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ===== Platforms ===== -->
    <section class="page-section reveal">
      <header class="section-head">
        <span class="section-num">04</span>
        <h2 class="section-title">Platforms</h2>
      </header>

      <div class="section-body">
        <p class="platform-line">
          YouTube ／ ColorSing ／ Topia ／ X
        </p>
      </div>
    </section>

    <!-- ===== Links ===== -->
    <section class="page-section reveal">
      <header class="section-head">
        <span class="section-num">05</span>
        <h2 class="section-title">Connect</h2>
      </header>

      <div class="section-body">
        <ul class="link-list">
          <li>
            <a href="https://x.com/carrot_tpa" target="_blank" rel="noopener noreferrer">
              <span class="link-name">X (Twitter)</span>
              <span class="link-handle">@carrot_tpa</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@carrot_singer" target="_blank" rel="noopener noreferrer">
              <span class="link-name">YouTube</span>
              <span class="link-handle">@carrot_singer</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://web.colorsing.com/share/live?live_id=2d0a51ab-7078-4853-9864-5078fbb9ebab" target="_blank" rel="noopener noreferrer">
              <span class="link-name">ColorSing</span>
              <span class="link-handle">Live Room</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://topia.tv/p/NvZQC" target="_blank" rel="noopener noreferrer">
              <span class="link-name">Topia</span>
              <span class="link-handle">Profile</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/qF7c6PfgJw" target="_blank" rel="noopener noreferrer">
              <span class="link-name">Discord</span>
              <span class="link-handle">きゃるのサーバー</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

  </div>
</Layout>

<script>
  // Scroll Reveal — shared module
  import('../scripts/reveal.ts');

  // Music notes animation
  function createMusicNotes() {
    const notes = ['♪', '♫', '♬', '♩'];
    const numberOfNotes = 10;

    for (let i = 0; i < numberOfNotes; i++) {
      setTimeout(() => {
        const note = document.createElement('div');
        note.className = 'music-note';
        note.textContent = notes[Math.floor(Math.random() * notes.length)];

        const randomX = Math.random() * window.innerWidth;
        note.style.left = `${randomX}px`;
        note.style.top = '0px';

        const duration = 2 + Math.random() * 2;
        note.style.animationDuration = `${duration}s`;

        document.body.appendChild(note);

        setTimeout(() => note.remove(), duration * 1000);
      }, i * 100);
    }
  }

  // Profile click handler
  let isHandling = false;
  async function handleProfileClick(e: Event) {
    if (isHandling) return;
    isHandling = true;
    setTimeout(() => { isHandling = false; }, 300);

    createMusicNotes();

    try {
      const response = await fetch('/message.txt');
      const message = await response.text();

      if (message.trim()) {
        const bubble = document.createElement('div');
        bubble.className = 'message-bubble';
        bubble.textContent = message.trim();

        const iconElement = e.currentTarget as HTMLElement;
        const iconRect = iconElement.getBoundingClientRect();

        bubble.style.top = `${iconRect.top - 20}px`;
        bubble.style.left = `${iconRect.left + iconRect.width / 2}px`;

        document.body.appendChild(bubble);

        setTimeout(() => {
          bubble.classList.add('fade-out');
          setTimeout(() => bubble.remove(), 500);
        }, 5000);
      }
    } catch (error) {
      console.log('メッセージファイルが見つかりませんでした');
    }
  }

  const profileIcon = document.querySelector('.cover-photo');
  profileIcon?.addEventListener('click', handleProfileClick);
</script>

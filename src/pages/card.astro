---
import Layout from '../layouts/Layout.astro';

// ★ここを編集してください★
const message = "はじめまして！きゃるです🥕";
---

<Layout
  title="きゃる | 歌い手 × MIX"
  description="歌い手きゃるのリンクページ"
  hideNavbar={true}
>
  <div class="card-page">
    <main class="card-main">

      <!-- Header / Profile -->
      <header class="card-head stagger-1">
        <div class="card-meta">
          <span class="meta-num">№ 001</span>
          <span class="meta-rule"></span>
          <span class="meta-label">Singer · Mix</span>
        </div>

        <figure class="avatar-figure">
          <img
            src="/photos/profile-main.png"
            alt="きゃる"
            class="avatar"
            width="120"
            height="120"
          />
        </figure>

        <h1 class="card-name">
          <span class="name-en">KYARU</span>
          <span class="name-ja">きゃる</span>
        </h1>
        <p class="card-role">歌い手 × 歌ってみたMIX</p>
      </header>

      <!-- Message -->
      <div class="message-block stagger-2">
        <p class="message">"{message}"</p>
      </div>

      <!-- Links -->
      <nav class="links-block stagger-3" aria-label="SNSリンク">
        <ul class="link-list">
          <li>
            <a href="https://x.com/carrot_tpa" target="_blank" rel="noopener noreferrer">
              <span class="link-name">X (Twitter)</span>
              <span class="link-handle">@carrot_tpa</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@carrot_singer" target="_blank" rel="noopener noreferrer">
              <span class="link-name">YouTube</span>
              <span class="link-handle">@carrot_singer</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://web.colorsing.com/share/live?live_id=2d0a51ab-7078-4853-9864-5078fbb9ebab" target="_blank" rel="noopener noreferrer">
              <span class="link-name">ColorSing</span>
              <span class="link-handle">Live Room</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://topia.tv/p/NvZQC" target="_blank" rel="noopener noreferrer">
              <span class="link-name">Topia</span>
              <span class="link-handle">Profile</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/qF7c6PfgJw" target="_blank" rel="noopener noreferrer">
              <span class="link-name">Discord</span>
              <span class="link-handle">きゃるのサーバー</span>
              <span class="link-arrow">→</span>
            </a>
          </li>
        </ul>
      </nav>

      <a href="/" class="hp-link stagger-3">
        <span>Visit Homepage</span>
        <span class="link-arrow">→</span>
      </a>

      <p class="footer-note">© KYARU</p>
    </main>
  </div>
</Layout>

<style>
  /* ===== Base ===== */
  .card-page {
    min-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 1.5rem 2.5rem;
  }

  /* ===== Layout ===== */
  .card-main {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: center;
  }

  /* ===== Stagger Animation ===== */
  .stagger-1 { animation: fadeUp 0.7s ease-out 0.1s both; }
  .stagger-2 { animation: fadeUp 0.7s ease-out 0.3s both; }
  .stagger-3 { animation: fadeUp 0.7s ease-out 0.5s both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== Header ===== */
  .card-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .meta-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-mute);
  }

  .meta-rule {
    width: 24px;
    height: 1px;
    background: var(--rule);
  }

  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ===== Avatar ===== */
  .avatar-figure {
    margin: 0 0 1.5rem;
  }

  .avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    filter: sepia(0.18) contrast(0.96) saturate(0.92);
    border: 1px solid var(--rule);
  }

  .card-name {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: center;
    margin-bottom: 0.6rem;
    line-height: 1;
  }

  .name-en {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.6rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .name-ja {
    font-family: var(--font-mincho);
    font-size: 0.9rem;
    color: var(--ink-mute);
    letter-spacing: 0.4em;
  }

  .card-role {
    font-family: var(--font-mincho);
    font-size: 0.9rem;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }

  /* ===== Message ===== */
  .message-block {
    width: 100%;
  }

  .message {
    font-family: var(--font-mincho);
    font-size: 0.98rem;
    color: var(--ink-soft);
    text-align: center;
    line-height: 1.95;
    margin: 0;
    padding: 1.1rem 1.5rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  /* ===== Link list ===== */
  .links-block {
    width: 100%;
  }

  .link-list {
    list-style: none;
    width: 100%;
  }

  .link-list li {
    border-bottom: 1px solid var(--rule);
  }

  .link-list li:first-child {
    border-top: 1px solid var(--rule);
  }

  .link-list a {
    display: grid;
    grid-template-columns: 1fr auto 16px;
    align-items: baseline;
    gap: 0.85rem;
    padding: 1.05rem 0.4rem;
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.25s ease, background-color 0.25s ease;
    min-height: 56px;
  }

  .link-list a:hover,
  .link-list a:active {
    padding-left: 1rem;
    background: var(--paper-warm);
  }

  .link-list .link-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink);
  }

  .link-list .link-handle {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }

  .link-list .link-arrow {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--ink-mute);
    transition: transform 0.25s ease, color 0.25s ease;
    text-align: right;
  }

  .link-list a:hover .link-arrow,
  .link-list a:active .link-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ===== HP link ===== */
  .hp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .hp-link:hover,
  .hp-link:active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hp-link .link-arrow {
    transition: transform 0.25s ease;
  }

  .hp-link:hover .link-arrow {
    transform: translateX(3px);
  }

  /* ===== Footer ===== */
  .footer-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ink-mute);
    margin: 0;
    padding-top: 0.5rem;
  }
</style>

---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-rule"></div>
    <div class="footer-content">
      <span class="footer-mark">KYARU</span>
      <span class="footer-meta">© {year} きゃる — All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 2rem 2.5rem;
    background: var(--paper);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-rule {
    height: 1px;
    background: var(--rule);
    margin-bottom: 2rem;
  }

  .footer-content {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-mark {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    letter-spacing: 0.15em;
    color: var(--ink);
  }

  .footer-meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }

  @media (max-width: 480px) {
    .site-footer {
      padding: 2.5rem 1.25rem 2rem;
    }

    .footer-content {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
